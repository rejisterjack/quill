# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL="postgresql://username:password@localhost:5432/quill"

# OpenRouter Free LLM & Embedding API Key
# Sign up and grab a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key-here"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:7392"

# Session secret. Required in production.
AUTH_SECRET="generate-a-strong-secret-key-here"

# Upstash Redis (required in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional providers
CLOUDINARY_URL=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
ENCRYPTION_KEY=""
AUDIT_ARCHIVE_URL=""
NEON_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
OPENAI_API_KEY=""
TUNING_MODEL="gpt-4o-mini-2024-07-18"
