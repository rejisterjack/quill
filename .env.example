# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:7392
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info

# =============================================================================
# AI — OpenRouter (chat, all LLM calls)
# =============================================================================
# Get a free key at https://openrouter.ai/keys (1,000 free requests/day on free models)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# =============================================================================
# AI — Embeddings (OpenRouter free model by default, Gemini optional)
# =============================================================================
# Default setup uses OpenRouter's free embedding model — no extra key needed,
# it reuses OPENROUTER_API_KEY. Dimensions must match the pgvector column.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Optional dedicated key; falls back to OPENROUTER_API_KEY (or OPENAI_API_KEY for OpenAI).
# EMBEDDING_API_KEY=
# Optional: Google Gemini key — only for Gemini chat models (BYOK per workspace)
# or EMBEDDING_PROVIDER=google. Not required by default.
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-api-key-here

# =============================================================================
# AUTH (NextAuth v5)
# =============================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-32-character-secret-key-here
NEXTAUTH_SECRET=generate-a-32-character-secret-key-here
NEXTAUTH_URL=http://localhost:7392

# OAuth Providers (GitHub & Google)
AUTH_GITHUB_ID=your-github-oauth-app-id
AUTH_GITHUB_SECRET=your-github-oauth-app-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# =============================================================================
# DATABASE (PostgreSQL with pgvector — Prisma Postgres / Neon / Supabase)
# =============================================================================
DATABASE_URL="postgresql://user:password@your-host/dbname?sslmode=require"

# =============================================================================
# STORAGE (Cloudinary)
# =============================================================================
# Get free account at https://cloudinary.com (25GB storage & bandwidth)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# =============================================================================
# REDIS (Upstash)
# =============================================================================
# Get free serverless Redis at https://console.upstash.com (10,000 requests/day)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================================================
# BACKGROUND JOBS (Inngest)
# =============================================================================
# Get free account at https://inngest.com (50,000 events/month)
INNGEST_SIGNING_KEY=signkey-prod-your-signing-key
INNGEST_EVENT_KEY=your-inngest-event-key

# =============================================================================
# REALTIME (Ably)
# =============================================================================
# Get free account at https://ably.com (6M messages/month)
ABLY_API_KEY=your-ably-api-key

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=generate-a-32-character-key-for-production
# Generate with: openssl rand -base64 32
CSRF_SECRET=generate-a-32-character-csrf-secret
# Generate with: openssl rand -base64 24
CRON_SECRET=generate-a-random-secret-for-cron-jobs
ALLOWED_ORIGINS=http://localhost:7392

# =============================================================================
# EMAIL (Resend)
# =============================================================================
# Get free account at https://resend.com (3,000 emails/month)
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_TO_EMAIL="your-email@example.com"
RESEND_WEBHOOK_SECRET="whsec_your-webhook-secret"

# =============================================================================
# RERANKER (Cohere)
# =============================================================================
# Get free trial key at https://cohere.com
COHERE_API_KEY=your-cohere-api-key-here
RERANKER_ENABLED=true
RERANKER_PROVIDER=cohere
